// Prisma schema — مكتبة أرين للكتب الشرعية
// PostgreSQL backed by Docker Compose (or an equivalent local instance).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  color     String?   @default("#6366f1")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id           Int            @id @default(autoincrement())
  title        String
  author       String
  categoryId   Int
  // Prices are whole Moroccan dirhams (the store sells in whole DH).
  price        Int
  // Purchase/cost price — Admin-only. Never exposed through public APIs.
  costPrice    Int?
  oldPrice     Int?
  discount     Int            @default(0)
  image        String?
  availability String         @default("in-stock")
  description  String?
  rating       Int            @default(5)
  isNew        Boolean        @default(false)
  isPopular    Boolean        @default(false)
  pages        Int?
  publisher    String?
  year         String?
  // Shipping overrides: null = use default store settings, 'free' = free shipping, 'custom' = custom price
  shippingMode String?
  // Custom shipping price in DH (only applies when shippingMode = 'custom')
  customShipping Int?
  category     Category       @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  images       ProductImage[]
  packageItems PackageItem[]
  marketingEvents MarketingEvent[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("products")
}

model Package {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?
  price        Int
  costPrice    Int?
  oldPrice     Int?
  discount     Int           @default(0)
  image        String?
  availability String        @default("in-stock")
  isNew        Boolean       @default(false)
  isPopular    Boolean       @default(false)
  shippingMode String?
  customShipping Int?
  items        PackageItem[]
  images       PackageImage[]
  orderItems   PackageOrderItem[]
  marketingEvents MarketingEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("packages")
}

model PackageItem {
  id        Int      @id @default(autoincrement())
  packageId Int
  productId Int
  sortOrder Int      @default(0)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([packageId, productId])
  @@map("package_items")
}

model PackageImage {
  id        Int      @id @default(autoincrement())
  packageId Int
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("package_images")
  @@index([packageId])
}

model PackageOrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int
  packageId      Int?
  packageTitle   String
  packageImage   String?
  itemsSnapshot  Json?
  quantity       Int
  unitPrice      Int
  totalPrice     Int
  unitCostPrice  Int?
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package        Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@map("package_order_items")
}

model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique
  fullName      String
  phone         String
  city          String
  address       String
  note          String?
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  status        OrderStatus   @default(PENDING)
  subtotal      Int
  shipping      Int
  total         Int
  items         OrderItem[]
  packageItems  PackageOrderItem[]
  marketingAttribution MarketingAttribution?
  marketingEvents      MarketingEvent[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  productId     Int?
  // Product snapshots — keep old orders historically correct even if the
  // product's title/price/image change or if the product is deleted later.
  productTitle  String
  productImage  String?
  quantity      Int
  // Selling-price snapshot. Admin profit math uses: unitPrice − unitCostPrice.
  unitPrice     Int
  totalPrice    Int
  // Purchase-cost snapshot taken at order time (Admin-only, never public).
  // NULL for orders created before cost tracking existed.
  unitCostPrice Int?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Admin {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  phone        String?
  name         String?
  // bcrypt hash — never plaintext, never exposed by any API.
  passwordHash String
  role         AdminRole     @default(ADMIN)
  status       String        @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  permissions  String[]      @default([])
  lastLoginAt  DateTime?
  // Security & Brute-Force Protection
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  lastLogin           DateTime?
  notes        String?
  createdBy    Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creator      Admin?        @relation("AdminCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAdmins Admin[]      @relation("AdminCreator")
  activityLogs ActivityLog[]

  @@map("admins")
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?
  actorName    String?
  actorEmail   String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor        Admin?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("activity_logs")
}

// Key/value store for non-secret Admin Panel settings.
// Secrets (API tokens, delivery credentials) must stay in server-side env vars.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("product_images")
  @@index([productId])
}

model Banner {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  image       String?
  link        String?
  type        String    @default("promotional")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("banners")
}

model StoreConfig {
  key       String   @id
  value     String
  type      String   @default("string")
  updatedAt DateTime @updatedAt

  @@map("store_config")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------------------------------------------------------
// Marketing & Meta Ads Models
// ---------------------------------------------------------

enum MarketingEventStatus {
  PENDING
  SENT
  FAILED
  DUPLICATE
  SKIPPED
}

enum CatalogSyncStatus {
  SYNCED
  PENDING
  FAILED
  OUT_OF_SYNC
}

enum SyncJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

model MarketingSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("marketing_settings")
}

model MarketingConnection {
  id             Int       @id @default(autoincrement())
  platform       String    @unique @default("meta")
  status         String    @default("NOT_CONFIGURED") // NOT_CONFIGURED, CONNECTED, EXPIRED, INVALID, ERROR
  accountName    String?
  accountId      String?
  pixelId        String?
  catalogId      String?
  tokenScope     String?
  tokenExpiresAt DateTime?
  lastCheckedAt  DateTime?
  lastSyncAt     DateTime?
  errorMessage   String?
  details        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("marketing_connections")
}

model MarketingEvent {
  id             Int                  @id @default(autoincrement())
  eventId        String               @unique
  eventName      String
  eventTime      DateTime             @default(now())
  source         String               @default("SERVER") // SERVER (CAPI), CLIENT (Pixel), SYSTEM
  actionSource   String               @default("website")
  eventSourceUrl String?
  status         MarketingEventStatus @default(PENDING)

  // Associated IDs
  orderId        Int?
  productId      Int?
  packageId      Int?

  // Financial & custom data
  value          Float?
  currency       String               @default("MAD")
  userData       Json?
  customData     Json?

  // Delivery / CAPI diagnostics
  retryCount     Int                  @default(0)
  maxRetries     Int                  @default(3)
  nextRetryAt    DateTime?
  fbtraceId      String?
  responseBody   Json?
  errorMessage   String?

  // Attribution relation
  attributionId  Int?
  attribution    MarketingAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product        Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  package        Package?              @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([eventName])
  @@index([status])
  @@index([eventTime])
  @@index([orderId])
  @@index([attributionId])
  @@map("marketing_events")
}

model MarketingAttribution {
  id                  Int       @id @default(autoincrement())
  orderId             Int?      @unique

  // UTM tracking
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  utmTerm             String?

  // Meta click identifier
  fbclid              String?
  fbp                 String?
  fbc                 String?

  // Meta Campaign references
  metaCampaignId      String?
  metaCampaignName    String?
  metaAdSetId         String?
  metaAdSetName       String?
  metaAdId            String?
  metaAdName          String?

  // Multi-touch model
  firstTouchSource    String?
  firstTouchMedium    String?
  firstTouchCampaign  String?
  firstTouchTimestamp DateTime?

  lastTouchSource     String?
  lastTouchMedium     String?
  lastTouchCampaign   String?
  lastTouchTimestamp  DateTime?

  // Session context
  landingPage         String?
  referrer            String?
  deviceType          String?
  ipAddress           String?
  userAgent           String?

  order               Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  events              MarketingEvent[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([utmSource])
  @@index([utmMedium])
  @@index([utmCampaign])
  @@index([metaCampaignId])
  @@index([fbclid])
  @@index([createdAt])
  @@map("marketing_attributions")
}

model MarketingCatalogItem {
  id             Int               @id @default(autoincrement())
  itemId         String            @unique // "book-1", "pkg-2"
  itemType       String            // 'BOOK' | 'PACKAGE'
  productId      Int?
  packageId      Int?
  externalMetaId String?

  title          String
  description    String?
  price          Int
  currency       String            @default("MAD")
  availability   String            @default("in stock")
  imageUrl       String?
  linkUrl        String?
  category       String?

  syncStatus     CatalogSyncStatus @default(PENDING)
  lastSyncedAt   DateTime?
  errorMessage   String?
  syncDetails    Json?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([syncStatus])
  @@index([itemType])
  @@map("marketing_catalog_items")
}

model MarketingSyncJob {
  id           Int           @id @default(autoincrement())
  jobType      String        // 'CATALOG_SYNC', 'CAMPAIGN_SYNC', 'EVENT_RETRY', 'TEST_EVENT'
  status       SyncJobStatus @default(PENDING)
  totalItems   Int           @default(0)
  syncedItems  Int           @default(0)
  failedItems  Int           @default(0)
  details      Json?
  errorMessage String?
  startedAt    DateTime      @default(now())
  completedAt  DateTime?

  @@index([jobType])
  @@index([status])
  @@index([startedAt])
  @@map("marketing_sync_jobs")
}

model MarketingCampaignCache {
  id                Int       @id @default(autoincrement())
  externalId        String    @unique // Meta Campaign ID
  name              String
  objective         String?
  status            String    // ACTIVE, PAUSED, ARCHIVED, etc.
  effectiveStatus   String?
  dailyBudget       Float?
  lifetimeBudget    Float?
  budgetRemaining   Float?
  startTime         DateTime?
  stopTime          DateTime?

  // Insights snapshot
  spend             Float     @default(0)
  impressions       Int       @default(0)
  reach             Int       @default(0)
  clicks            Int       @default(0)
  cpc               Float     @default(0)
  cpm               Float     @default(0)
  ctr               Float     @default(0)
  conversions       Int       @default(0)
  metaRevenue       Float     @default(0)

  // Arine local attributed metrics
  attributedOrders  Int       @default(0)
  attributedRevenue Float     @default(0)
  roas              Float     @default(0)
  cpa               Float     @default(0)

  lastSyncedAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([externalId])
  @@map("marketing_campaigns_cache")
}