# Backend environment — copy to `.env` and adjust for your machine.
# `.env` is gitignored; never commit real values.

# PostgreSQL connection (PostgreSQL 16, see docker-compose.yml).
DATABASE_URL="postgresql://arine:arine_dev_password@localhost:5432/arine"

# Server port for the API.
PORT="4000"

# Allowed CORS origins (the customer Store and the Admin Panel).
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# development | production. Cookies become Secure (HTTPS-only) in production.
NODE_ENV="development"

# Any long random string — required to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Set TRUST_PROXY=1 when the API runs behind a reverse proxy (e.g. nginx).
# TRUST_PROXY="1"

# First-time Admin bootstrap (used by `node server/prisma/seed-admin.js`).
# The password is hashed with bcrypt and never stored as plaintext.
# ADMIN_INITIAL_USERNAME="admin"
# ADMIN_INITIAL_PASSWORD="<at-least-8-characters>"
# ADMIN_INITIAL_NAME="مدير أرين"