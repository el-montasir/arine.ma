# Frontend (Vite) — REST API base URL
VITE_API_URL="http://localhost:4000/api"

# Frontend (Vite) — advertise responsive WebP srcsets (/uploads/...-400w.webp).
#
# A srcset candidate is advertised ONLY for a width the server recorded as
# generated (see src/lib/image-metadata.js), so this flag is now a plain
# on/off for the feature rather than a safety interlock: media the server has
# no record for renders as the original with no srcset, which is always
# correct, merely unoptimized.
#
# Leave OFF until server/scripts/backfill-image-variants.js --execute
# --write-metadata has run, so the legacy catalogue has widths recorded too.
VITE_IMAGE_VARIANTS="false"